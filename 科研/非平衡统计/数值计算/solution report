            occ, occ_idx, free_idx, nn_list, N_occ, beta, epsilon_meV);
        occ_rows = nn_list(occ, :);
        COH_sum  = COH_sum + double(sum(occ(occ_rows(:)))) / N_occ;
    end
    COH_mean(iT) = COH_sum / N_sample;
